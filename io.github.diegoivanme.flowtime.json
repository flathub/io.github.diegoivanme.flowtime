{
  "app-id": "io.github.diegoivanme.flowtime",
  "runtime": "org.gnome.Platform",
  "runtime-version": "48",
  "sdk": "org.gnome.Sdk",
  "command": "flowtime",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--socket=wayland",
    "--device=dri"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "/share/vala",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "blueprint-compiler",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/jwestman/blueprint-compiler",
          "tag": "v0.18.0",
          "x-checker-data": {
            "type": "git",
            "tag-pattern": "^v([\\d.]+)$"
          }
        }
      ]
    },
    {
      "name": "libportal",
      "buildsystem": "meson",
      "config-opts": [
        "-Dbackend-gtk3=disabled",
        "-Dbackend-gtk4=enabled",
        "-Dbackend-qt5=disabled",
        "-Ddocs=false",
        "-Dtests=false"
      ],
      "sources": [
        {
          "url": "https://github.com/flatpak/libportal.git",
          "type": "git",
          "tag": "0.9.1",
          "commit": "8f5dc8d192f6e31dafe69e35219e3b707bde71ce",
          "x-checker-data": {
            "type": "git",
            "tag-pattern": "^([\\d.]+)$"
          }
        }
      ]
    },
    {
      "name": "flowtime",
      "builddir": true,
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/Diego-Ivan/Flowtime.git",
          "tag": "v6.5",
          "commit": "e6bc082a30e2e135086ad91435451b7da3751465",
          "x-checker-data": {
            "type": "git",
            "tag-pattern": "^v([\\d.]+)$"
          }
        }
      ]
    }
  ]
}
